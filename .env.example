# Copy to .env and fill in values
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# Free-tier clip generation providers
GOOGLE_AI_STUDIO_API_KEY=your_google_ai_studio_key_here
KLING_API_KEY=your_kling_api_key_here
HF_API_TOKEN=your_huggingface_token_here
PEXELS_API_KEY=your_pexels_api_key_here

# Narration. Optional and off by default: pipeline/tts.py skips ElevenLabs
# unless this is set, and falls back to Edge TTS, which is free. Note the free
# 10k characters are web-UI only — API access needs a paid plan. A 60-75s story
# is roughly 800-1000 characters.
# ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# LLM router (design-v3) — add whichever you have.
# llm_keys.json takes priority; these are the fallback when its api_key is empty.
GROQ_API_KEY=your_groq_api_key_here
CEREBRAS_API_KEY=your_cerebras_api_key_here
XAI_API_KEY=your_xai_api_key_here
PERPLEXITY_API_KEY=your_perplexity_api_key_here
NVIDIA_API_KEY=your_nvidia_nim_api_key_here   # NVIDIA_NIM_API_KEY also accepted
# GOOGLE_AI_STUDIO_API_KEY already listed above (reused for Gemini)

# Background audio and other providers
PIXABAY_API_KEY=           # free at pixabay.com — needed for background chanting audio

# Scheduler — Google Drive service account
GOOGLE_DRIVE_SERVICE_ACCOUNT_JSON=credentials/drive_service_account.json

# Scheduler — cron-job.org API
CRONJOB_API_KEY=your_cronjob_org_api_key_here

# Scheduler — GitHub dispatch token (for cron-job.org to trigger Actions)
GITHUB_DISPATCH_TOKEN=your_github_pat_with_repo_scope

# Engagement tracking
INSTAGRAM_ACCESS_TOKEN=your_instagram_access_token
FACEBOOK_PAGE_ACCESS_TOKEN=your_facebook_page_access_token
